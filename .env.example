# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Server-only secret key, used to log in with a username.
# Supabase > Project Settings > API Keys > Secret keys. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=your-secret-key

# Any long random string. Vercel sends it when running the daily Roblox sync
# (vercel.json), and /api/cron/sync-roblox rejects requests without it.
CRON_SECRET=your-random-string

# How many games to import each day from each Roblox list (Top Playing Now,
# Up-and-Coming). Leave unset for 25. Set to 0 to turn the import off.
# ROBLOX_IMPORT_PER_LIST=25
